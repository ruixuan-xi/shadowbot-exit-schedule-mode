# ============================================================
#  影刀退出调度工具 —— 配置文件
#  把这个文件改名为 config.txt 后生效
# ============================================================
#
#  什么时候需要填？
#    只在「任务正在运行、需要远程停掉它」时才用到。
#    如果平时按快捷键时都是空闲状态，这两项留空也能正常退出调度。
#
#  怎么获取？
#    影刀控制台 → API 执行 → API 配置 → 新增，会得到一对：
#      accessKeyId / accessKeySecret
#    需要企业管理员账号才能创建。
#
#  安全提醒：
#    这份密钥等同于企业 API 调用凭证，不要提交到代码仓库、不要发到群里。
#
# ------------------------------------------------------------
#  填写格式：等号两边不要加空格，不要加引号
# ------------------------------------------------------------

accessKeyId=XXX
accessKeySecret=XXX

# 停止指令发出后，最多等任务结束多少秒（默认 45）
# 任务体量大、收尾慢的可以调大到 120
maxWaitSeconds=45

# 切模式后，最多等多少秒让状态真正变过来（默认 20，脚本会轮询探测）
# 低配机器 / 装了杀毒软件拖慢启动的，可以调大到 40
switchTimeoutSeconds=20
